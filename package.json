{
  "name": "chronik-events",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chronik — automatischer Veranstaltungskalender für Mittelalter, LARP und Reenactment in Deutschland",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && node scripts/build-static.mjs",
    "build:vite": "tsc --noEmit && vite build",
    "build:static": "node scripts/build-static.mjs",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "python scripts/generate_icons.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
