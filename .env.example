# ── frontend (Vite) ───────────────────────────────────────────────────────
# Leave empty to run the prototype with the bundled demo catalogue.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── required for live collection ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── crawler etiquette / operations ─────────────────────────────────────────
CONTACT_EMAIL=hello@chronik.events
CRAWLER_USER_AGENT=ChronikBot/1.0 (+https://chronik.events/bot; mailto:hello@chronik.events)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODE_DELAY_SECONDS=1.1
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_BYTES=2500000
MAX_PAGES_PER_SOURCE=2
CACHE_TTL_HOURS=12

# Set to false to run without paid services (heuristic extraction + city fallback).
CHRONIK_USE_AI=true
CHRONIK_USE_GEOCODER=true
